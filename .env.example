# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe Secret Key (sk_test_... or sk_live_...)
# Used for processing real $7.99 all-access subscriptions and owner revenue collection.
STRIPE_SECRET_KEY="sk_test_example"

# STRIPE_WEBHOOK_SECRET: Optional Stripe Webhook signing secret for subscription lifecycle events
STRIPE_WEBHOOK_SECRET="whsec_example"

# OWNER_PAYOUT_EMAIL: Email where owner receives payout notifications and statements
OWNER_PAYOUT_EMAIL="ntaijo.fn@gmail.com"

# TWILIO SMS GATEWAY (Optional - for physical cellular SMS dispatch)
# Configure these to deliver real 6-digit SMS text messages directly to cell phones
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# SMTP & EMAIL NOTIFICATION DISPATCH (Optional)
# Sender address for verification codes, password resets, and automated payment notifications
EMAIL_FROM="LifeOS <lifeos-app@gmail.com>"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
